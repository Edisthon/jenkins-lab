global:
  scrape_interval: 15s

scrape_configs:
  - job_name: 'flask_app'
    metrics_path: '/metrics'
    static_configs:
      # Dynamically grab the IP of the prod server from the Ansible inventory!
      - targets: ['{{ hostvars[groups["prod_servers"][0]]["inventory_hostname"] }}:80']

  - job_name: 'node_exporter'
    static_configs:
      - targets: ['{{ hostvars[groups["prod_servers"][0]]["inventory_hostname"] }}:9100']
